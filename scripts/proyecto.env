# Configuración propia de myTravelsArround para los scripts de scripts/ (negocio, no plantilla).

# Términos del negocio que no pueden aparecer en las piezas de plantilla (regla 6 de AGENTS.md).
# Expresión regular extendida, sin distinguir mayúsculas.
TERMINOS_NEGOCIO='viaje|travel|leaflet|contribuc|contribution|google maps|google fotos|fernando|nominatim|mapa'

# Piezas de plantilla donde se buscan, separadas por espacios, y ficheros que se excluyen: este
# fichero (es del negocio) y el inventario de la plantilla, que nombra el proyecto a propósito.
PLANTILLA_RUTAS='scripts .claude/skills docs/agentes/plantilla'
PLANTILLA_EXCLUIR='scripts/proyecto.env docs/agentes/plantilla/README.md'
